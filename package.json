{
  "name": "private-gather-native",
  "version": "1.1.200",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "prebuild:clean": "expo prebuild --clean",
    "doctor": "expo-doctor",
    "android:release": "expo run:android --variant release",
    "check:ready": "node scripts/check-ready.mjs",
    "prepare:android": "bash scripts/prepare-android.sh",
    "prepare:ios": "bash scripts/prepare-ios.sh",
    "build:eas:android:admin": "npx eas-cli@latest build --platform android --profile admin",
    "build:eas:ios:admin": "npx eas-cli@latest build --platform ios --profile admin",
    "build:eas:all:admin": "npx eas-cli@latest build --platform all --profile admin",
    "build:eas:android:production": "npx eas-cli@latest build --platform android --profile production",
    "build:eas:ios:production": "npx eas-cli@latest build --platform ios --profile production",
    "config:public": "npx expo config --type public",
    "postinstall": "node scripts/fix-callkeep.mjs"
  },
  "dependencies": {
    "expo": "~57.0.17",
    "expo-constants": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-notifications": "~57.0.16",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-callkeep": "4.3.16",
    "react-native-keychain": "10.0.0",
    "react-native-webrtc": "124.0.8",
    "expo-build-properties": "~57.0.16",
    "expo-dev-client": "~57.0.18",
    "expo-task-manager": "~57.0.15",
    "react-native-voip-push-notification": "3.3.3",
    "expo-symbols": "~57.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@react-navigation/bottom-tabs": "7.18.18",
    "expo-audio": "~57.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-file-system": "~57.0.6",
    "expo-intent-launcher": "~57.0.1",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  }
}
