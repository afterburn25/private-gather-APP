# Private Gather native application
EXPO_PUBLIC_PG_API_BASE=https://member.privategather.com/api/v1/native
EXPO_PUBLIC_PG_PUSH_MODE=native
PG_NATIVE_RUNTIME_VERSION=pg-native-1

# Filled after `eas init` / Expo project creation.
EAS_PROJECT_ID=

# Optional custom Expo Update protocol endpoint controlled by Private Gather.
EXPO_UPDATES_URL=

# Android: path to Firebase google-services.json on the build machine.
# For EAS use a secret file environment variable with this name.
GOOGLE_SERVICES_JSON=

# Optional explicit local build numbers. EAS production can auto-increment instead.
ANDROID_VERSION_CODE=1188
IOS_BUILD_NUMBER=1188
